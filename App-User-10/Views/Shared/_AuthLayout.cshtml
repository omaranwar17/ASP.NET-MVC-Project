<!DOCTYPE html>
<html>
<head>
    <title>Creative Colorlib @ViewData["Title"] Form</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />

    <link href="~/css/auth-style.css" rel="stylesheet" type="text/css" media="all" />
    <link href="//fonts.googleapis.com/css?family=Roboto:300,300i,400,400i,700,700i" rel="stylesheet">
</head>
<body>
    @* <main> *@
        <div class="main-w3layouts wrapper">
            <h1>Creative @ViewData["Title"] Form</h1>

            <div class="main-agileinfo">
                <div class="agileits-top">
                    @RenderBody()
                </div>
            </div>

            <div class="colorlibcopy-agile">
                <p>© 2018 Colorlib Signup Form. All rights reserved | Design by
                    <a href="https://colorlib.com/" target="_blank">Colorlib</a>
                </p>
            </div>

            <ul class="colorlib-bubbles">
                <li></li><li></li><li></li><li></li><li></li>
                <li></li><li></li><li></li><li></li><li></li>
            </ul>
        </div>
    @* </main> *@
</body>
</html>