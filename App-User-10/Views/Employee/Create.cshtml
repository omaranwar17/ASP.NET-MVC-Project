@model CreateEmployeeDto

@{
    ViewData["title"] = "Create";
}

<div class="row justify-content-center align-content-center mt-3">
    <h1 class="col-8 my-4">Create Employee</h1>
    <form method="post" asp-controller="Employee" asp-action="Create" class=" row col-8" enctype="multipart/form-data">
       <partial name="_Emp_Details" model="Model" /> 


             <div class="form-group mb-3 col-6">
            <label class="form-label" asp-for="Gender"></label>
            <div>
         @foreach (Gender genderOption in Enum.GetValues<Gender>())
                {
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" asp-for="Gender" value="@genderOption" />
                        <label class="form-check-label">@genderOption</label>
                    </div>
                }
              </div>
               <span asp-validation-for="Gender" class="text-danger"></span>
            </div>

 <div class="form-group mb-3 col-6">
     <label class="form-label" asp-for="EmployeeType"></label>
 @{
       var selectedEmployeeType = Model.EmployeeType;
}
    <select asp-for="EmployeeType" class="form-control">
    <option value="">-- Select Employee Type --</option>
  @foreach (var value in Enum.GetValues(typeof(EmployeeType)))
     {
        var et = (EmployeeType)value;
        <option value="@et" selected="@(et == Model.EmployeeType)">
            @et
        </option>
    }
</select>
    <span asp-validation-for="EmployeeType" class="text-danger"></span>
</div>
        <div class="mt-4 m-auto">
            <input class="btn btn-primary" type="submit" value="Save" />
            <a asp-controller="Employee" asp-action="Index" class="btn btn-outline-dark">Back to list</a>
        </div>
    </form>
    
</div>
@section SectionValidation{
       <script src="~/lib/jquery/dist/jquery.validate.min.js"></script>
       <script src="~/lib/jquery/dist/jquery.validate.unobtrusive.min.js"></script>
}