@model UsersViewM

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete Page</h1>
<br />
<br />

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input type="hidden" asp-for="Id" />
    <partial name="User_Delete" model="@Model" />

    <input type="submit" value="Delete" class="btn my-2 btn-danger" />

    <a asp-action="Index" class="btn my-2 btn-light">Back To List</a>
</form>
